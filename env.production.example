# ====================================================================
# EAF CONNECT – HOSTINGER PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================
# Instructions:
# 1. Rename this file to .env on Hostinger
# 2. Update database credentials to match your Hostinger MySQL DB
# 3. Ensure CI_ENVIRONMENT is set to production
# ====================================================================

CI_ENVIRONMENT = production

# --------------------------------------------------------------------
# APPLICATION SETTINGS
# --------------------------------------------------------------------
app.baseURL = 'https://eafconnect.com/'
app.forceGlobalSecureRequests = true
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ci_session'
app.sessionExpiration = 7200
app.sessionSavePath = WRITEPATH . 'session'

# --------------------------------------------------------------------
# DATABASE CONFIGURATION (HOSTINGER MYSQL)
# --------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = u594406910_eafv2
database.default.username = u594406910_eafv2
database.default.password = 'o=f5xPZ8'
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.port = 3306

# --------------------------------------------------------------------
# SECURITY & LOGGING
# --------------------------------------------------------------------
logger.threshold = 1
